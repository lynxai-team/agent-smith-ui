{
  "name": "@agent-smith/ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "net": "vite preview --host",
    "preview": "vite preview --port 5173",
    "local": "node dist/bin/index.js",
    "server": "node  --loader ts-node/esm --watch src/bin/index.ts",
    "build:check": "mkdir -p src/apps",
    "build:compile": "vite build && cp -r src/apps dist/",
    "build:compress": "gzipper c ./dist --verbose --incremental --exclude avif,jpg --threshold 999 --remove-larger --brotli --brotli-param-mode font",
    "build:server": "tsc -p tsconfig_bin.json",
    "build": "run-s build:check build:compile build:server"
  },
  "dependencies": {
    "@agent-smith/app-debate": "file:../agent-smith-apps/debate",
    "@agent-smith/server": "^0.2.8",
    "@agent-smith/wscli": "^0.0.10",
    "@fontsource/roboto": "^5.3.0",
    "@snowind/header": "^0.1.0",
    "@snowind/plugin": "^0.5.0",
    "@snowind/state": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "highlight.js": "^11.12.0",
    "markstream-vue": "^2.0.8",
    "mermaid": "^11.17.2",
    "modprompt": "^0.14.3",
    "restmix": "^0.6.1",
    "stream-markdown": "^0.0.16",
    "stream-monaco": "^0.0.49",
    "vue": "3.5.42",
    "vue-router": "5.3.1",
    "vuecodit": "^0.0.11",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "vue-reactivity": "^1.0.3",
    "openai": "^7.10.0",
    "@agent-smith/types": "^0.0.11",
    "@iconify/json": "^2.2.525",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "3.5.42",
    "autoprefixer": "^10.5.5",
    "gzipper": "^8.3.0",
    "npm-run-all": "^4.1.5",
    "path": "^0.12.7",
    "postcss": "8.5.28",
    "sass": "1.104.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-semantic-colors": "^0.6.0",
    "ts-node": "^10.9.2",
    "tslib": "2.8.1",
    "typescript": "^7.0.2",
    "vite": "8.2.2"
  },
  "type": "module",
  "preferGlobal": true,
  "main": "./dist/main.js",
  "exports": {
    ".": {
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "lmui": "./dist/bin/server.js"
  }
}